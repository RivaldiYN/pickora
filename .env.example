# PostgreSQL connection string (Supabase / Neon / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pickora?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="pickora-development-auth-secret-key-32chars"
AUTH_SECRET="pickora-development-auth-secret-key-32chars"

# Default Admin Seed Credentials
ADMIN_EMAIL="admin@pickora.local"
ADMIN_PASSWORD="adminpassword123"
# Site Canonical Production Domain
NEXT_PUBLIC_SITE_URL="https://pickora.com"

# Google AdSense Monetization (Leave blank until approved)
# Example: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
# Example: pub-1234567890123456
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=""
